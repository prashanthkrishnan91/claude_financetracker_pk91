{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 /home/user/claude_financetracker_pk91/scripts/build_code_graph.py 2>/dev/null || true",
            "timeout": 60,
            "statusMessage": "Building code graph…",
            "async": true
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "bash /home/user/claude_financetracker_pk91/scripts/rebuild_graph_on_edit.sh 2>/dev/null || true",
            "timeout": 60,
            "statusMessage": "Updating code graph…",
            "async": true
          }
        ]
      }
    ]
  }
}
