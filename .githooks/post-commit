#!/bin/bash
# Post-commit hook: auto-update progress_log.md with latest commit

REPO_ROOT=$(git rev-parse --show-toplevel)
SCRIPT="$REPO_ROOT/scripts/update_docs.py"
FLAG="$REPO_ROOT/.git/POST_COMMIT_RUNNING"

# Guard against infinite loop: amend triggers post-commit again
if [ -f "$FLAG" ]; then
    exit 0
fi

if [ -f "$SCRIPT" ]; then
    touch "$FLAG"
    python3 "$SCRIPT"

    # Stage updated docs if they changed, then amend once
    if ! git diff --quiet v2/progress_log.md 2>/dev/null; then
        git add v2/progress_log.md
        git commit --amend --no-edit --no-verify 2>/dev/null || true
    fi

    rm -f "$FLAG"
fi
