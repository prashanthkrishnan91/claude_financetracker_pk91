#!/bin/bash
# Pre-commit hook: validate code before allowing commits

set -e

REPO_ROOT=$(git rev-parse --show-toplevel)
EXIT_CODE=0

# Colors for output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m' # No Color

echo -e "${YELLOW}Running pre-commit checks...${NC}"

# 1. Check for secrets (prevent committing actual secret values, not just key names)
echo -n "Checking for secrets... "
# Match assignment patterns: key = "value" where value looks like a real secret (20+ chars)
# Avoids false positives on variable names, docstrings, and comments
if git diff --cached | grep -E '^\+' | grep -v '^\+\+\+' | \
    grep -iE '(api.?key|password|secret|token|credential)\s*[=:]\s*["\x27][a-zA-Z0-9+/._-]{20,}["\x27]' >/dev/null 2>&1; then
    echo -e "${RED}FAILED${NC}"
    echo "  ✗ Detected potential hardcoded secret value in staged changes. Do not commit API keys!"
    EXIT_CODE=1
else
    echo -e "${GREEN}OK${NC}"
fi

# 2. Check Python syntax
echo -n "Checking Python syntax... "
PYTHON_FILES=$(git diff --cached --name-only --diff-filter=ACM | grep -E '\.py$' || true)
if [ -n "$PYTHON_FILES" ]; then
    for file in $PYTHON_FILES; do
        if [ -f "$file" ] && python3 -m py_compile "$file" 2>/dev/null; then
            :
        else
            echo -e "${RED}FAILED${NC}"
            echo "  ✗ Python syntax error in: $file"
            EXIT_CODE=1
        fi
    done
    echo -e "${GREEN}OK${NC}"
else
    echo -e "${GREEN}SKIPPED${NC} (no Python files)"
fi

# 3. Check for large files (> 10MB)
echo -n "Checking file sizes... "
LARGE_FILES=$(git diff --cached --name-only --diff-filter=ACM | while read file; do
    if [ -f "$file" ]; then
        size=$(stat -f%z "$file" 2>/dev/null || stat -c%s "$file" 2>/dev/null || echo 0)
        if [ "$size" -gt 10485760 ]; then
            echo "$file ($((size / 1048576))MB)"
        fi
    fi
done)

if [ -n "$LARGE_FILES" ]; then
    echo -e "${RED}FAILED${NC}"
    echo "  ✗ Large files detected (limit: 10MB):"
    echo "$LARGE_FILES" | sed 's/^/    /'
    EXIT_CODE=1
else
    echo -e "${GREEN}OK${NC}"
fi

# 4. Check for trailing whitespace
echo -n "Checking for trailing whitespace... "
if git diff --cached | grep -E '^\+.*\s+$' >/dev/null 2>&1; then
    echo -e "${RED}FAILED${NC}"
    echo "  ✗ Trailing whitespace detected"
    EXIT_CODE=1
else
    echo -e "${GREEN}OK${NC}"
fi

# 5. Validate JSON in package.json, tsconfig.json
echo -n "Validating JSON files... "
JSON_FILES=$(git diff --cached --name-only --diff-filter=ACM | grep -E '\.(json|jsonc)$' || true)
if [ -n "$JSON_FILES" ]; then
    for file in $JSON_FILES; do
        if [ -f "$file" ] && ! python3 -m json.tool "$file" >/dev/null 2>&1; then
            echo -e "${RED}FAILED${NC}"
            echo "  ✗ Invalid JSON in: $file"
            EXIT_CODE=1
        fi
    done
    echo -e "${GREEN}OK${NC}"
else
    echo -e "${GREEN}SKIPPED${NC} (no JSON files)"
fi

if [ $EXIT_CODE -eq 0 ]; then
    echo -e "${GREEN}All checks passed!${NC}"
else
    echo -e "${RED}Pre-commit checks failed. Fix errors above and try again.${NC}"
fi

exit $EXIT_CODE
