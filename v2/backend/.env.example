# ── Application ───────────────────────────────────────────────────────────────
DEBUG=true
LOG_LEVEL=INFO

# ── Supabase ──────────────────────────────────────────────────────────────────
# Get these from: https://supabase.com/dashboard → Settings → API
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=eyJ...your-anon-key
SUPABASE_SERVICE_ROLE_KEY=eyJ...your-service-role-key
SUPABASE_JWT_SECRET=your-jwt-secret

# ── Encryption Key ────────────────────────────────────────────────────────────
# 32-byte hex key for AES-256-GCM encryption of stored API keys
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
ENCRYPTION_KEY=your-64-char-hex-key-here

# ── CORS (comma-separated origins) ───────────────────────────────────────────
CORS_ORIGINS=["http://localhost:3000","http://localhost:8000"]

# ── Plaid (optional — users can also set their own keys via API) ──────────────
PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_ENV=sandbox

# ── Financial APIs (optional fallbacks) ───────────────────────────────────────
FINNHUB_API_KEY=
POLYGON_API_KEY=
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
